aws_region        = "eu-west-1"
state_bucket_name = "replace-with-the-shared-state-bucket-name"

# Choose a Kubernetes version currently supported by EKS in your region.
kubernetes_version = "1.34"

# Replace with the public IP range of your office or VPN.
api_allowed_cidrs  = ["203.0.113.10/32"]

domain_name     = "notes-api.example.com"
route53_zone_id = "Z0123456789EXAMPLE"
